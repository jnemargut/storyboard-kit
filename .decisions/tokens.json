{
  "tradition": "Marker Comp (storyboard tradition; editor chrome derived from it)",
  "calibration": "none (era-stable technique)",
  "color": {
    "ramp": {
      "50": "#fbfaf7",
      "100": "#f1f1ef",
      "200": "#e4e6e8",
      "300": "#d7dade",
      "400": "#b9bec4",
      "500": "#959ba2",
      "600": "#6f777f",
      "700": "#4d535a",
      "800": "#2e3236",
      "900": "#1c1c1e"
    },
    "accent": {
      "product": "#0e9aa7",
      "productPressed": "#0b7f8a",
      "productTint": "#8fd6dc",
      "caption": "#fff6bf"
    },
    "semantic": {
      "success": "#2f9e44",
      "danger": "#c92a2a"
    },
    "role": {
      "paper": "#fbfaf7",
      "ink": "#1c1c1e",
      "markerLight": "#d7dade",
      "markerMid": "#b9bec4",
      "markerDark": "#6f777f"
    }
  },
  "font": {
    "title": "'Permanent Marker', cursive",
    "lettering": "'Patrick Hand', cursive",
    "ui": "'Work Sans', sans-serif",
    "mono": "'IBM Plex Mono', monospace",
    "googleFonts": "https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Patrick+Hand&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
  },
  "typeScale": {
    "xs": "12px",
    "sm": "14px",
    "base": "16px",
    "lg": "20px",
    "xl": "28px",
    "2xl": "40px",
    "3xl": "56px"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "96px"
  },
  "radius": {
    "none": "0",
    "sm": "2px",
    "md": "4px",
    "lg": "8px"
  },
  "shadow": {
    "L1": "0 1px 0 rgba(28,28,30,.12)",
    "L2": "3px 3px 0 #1c1c1e",
    "L3": "5px 5px 0 #1c1c1e",
    "L4": "8px 8px 0 #1c1c1e"
  },
  "motion": {
    "ease": "cubic-bezier(.2,.7,.3,1)",
    "fast": "100ms",
    "base": "180ms",
    "slow": "280ms"
  },
  "stroke": {
    "fineliner": "2.1",
    "detail": "1.2",
    "panelBorder": "2.6",
    "markerOffsetX": "2.2",
    "markerOffsetY": "1.8",
    "wobble": {
      "baseFrequency": ".035",
      "numOctaves": 2,
      "scale": 1.6
    },
    "bleed": {
      "baseFrequency": ".05",
      "numOctaves": 2,
      "scale": 3
    }
  },
  "rules": [
    "Only software touchpoints (screens, taps, notifications, cursors) use the product accent; everything else is ink + 3 cool greys",
    "Marker fills sit offset from the line (misregistration), never perfectly inside it",
    "Bubble tails always aim at the speaker's head anchor",
    "Captions use the caption yellow; titles in Permanent Marker, all other lettering in Patrick Hand",
    "Editor chrome is quiet: white, 1px lines, solid offset shadows only on floating tools"
  ]
}